# Discord Bot Token (Required)
DISCORD_TOKEN=your_discord_bot_token_here

# PostgreSQL Database Configuration
# Railway automatically provides DATABASE_URL when you add a PostgreSQL database
# For local development, use one of these formats:

# Option 1: Connection String (Recommended)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mvp_bot

# Option 2: Individual Variables (Alternative)
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mvp_bot

# Environment
NODE_ENV=development

# Top.gg API Token (Optional, for Vote Reward verification)
TOPGG_TOKEN=your_topgg_token_here

# Top.gg Webhook Secret / Authorization (Required for auto-rewarding votes; starts with whs_)
TOPGG_WEBHOOK_PASSWORD=whs_your_webhook_secret_here

# Asset Hosting Pipeline (Central Forum Image Storage)
IMAGE_HOST_GUILD_ID=your_image_host_guild_id
IMAGE_HOST_ITEMS_CHANNEL_ID=your_items_forum_channel_id
IMAGE_HOST_AVATARS_CHANNEL_ID=your_avatars_forum_channel_id
IMAGE_HOST_BOXES_CHANNEL_ID=your_boxes_forum_channel_id
IMAGE_HOST_EMBEDS_CHANNEL_ID=your_embeds_forum_channel_id


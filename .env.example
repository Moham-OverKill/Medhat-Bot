# Discord Bot Token (Required)
DISCORD_TOKEN=your_discord_bot_token_here

# PostgreSQL Database Configuration
# Railway automatically provides DATABASE_URL when you add a PostgreSQL database
# For local development, use one of these formats:

# Option 1: Connection String (Recommended)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mvp_bot

# Option 2: Individual Variables (Alternative)
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mvp_bot

# Environment
NODE_ENV=development
